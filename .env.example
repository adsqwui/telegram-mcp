# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Session file (Telethon adds .session). Gives full access to the account.
# TG_SESSION=sessions/mcp

# "today" / "yesterday" and the times in the output use this timezone
# TG_TIMEZONE=Europe/Moscow

# true = only reading, every sending/creating tool is refused
# TG_READ_ONLY=false

# Pause between two write actions, seconds
# TG_MIN_ACTION_GAP=1.0

# Downloaded media and the transcript cache
# TG_FILES_DIR=files
# tg_send_file only sends local files from these folders (separate with ":")
# TG_ALLOWED_ROOTS=files
# Bigger files are saved on the server but not returned inline
# TG_MAX_INLINE_MB=10

# Voice transcription (faster-whisper, runs locally on CPU)
# TG_TRANSCRIBE=true
# tiny / base / small / medium / large-v3. small needs ~1 GB RAM, base ~500 MB
# TG_WHISPER_MODEL=small
# Empty = detect the language automatically
# TG_WHISPER_LANGUAGE=
# Longer voice messages are not transcribed automatically by tg_read_messages
# TG_TRANSCRIBE_MAX_SECONDS=600

# HTTP mode (telegram-mcp --transport http)
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# Required when MCP_HOST is not a loopback address
# MCP_BEARER_TOKEN=
